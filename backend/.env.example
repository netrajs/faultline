# Copy to .env and fill in. Never commit .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=faultline

# Neo4j holds the graph. Analysis never queries it on the hot path.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional. Narration falls back to an offline template renderer when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# anvil | base-sepolia | replay
ANCHOR_MODE=replay
ANCHOR_RPC_URL=
ANCHOR_CONTRACT_ADDRESS=
